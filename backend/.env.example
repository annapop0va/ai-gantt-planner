# Copy to .env and adjust. Never commit real secrets — this file is gitignored
# once copied to `.env`; only OPENROUTER_API_KEY below is an actual secret.

APP_ENV=development

# Comma-separated list of allowed CORS origins. Never use a wildcard in production.
FRONTEND_ORIGINS=http://localhost:5173

# Exposes POST /api/v1/projects/{project_id}/changes — a development/testing-only
# endpoint for exercising ChangeSet operations without the chat/agent layer.
# Must stay false in anything resembling production.
ENABLE_DEV_ENDPOINTS=false

# --- AI agent (OpenRouter + MCP) --------------------------------------------
# Leave OPENROUTER_API_KEY / OPENROUTER_MODEL unset to run the app without AI:
# health/import/export/Gantt all work; POST /chat returns AI_NOT_CONFIGURED.
# Get a key at https://openrouter.ai/keys. Pick a model that supports native
# tool/function calling (OpenRouter marks these explicitly on its model list).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=60

# These 3 are conservative starting points. A free/reasoning-heavy model can
# need noticeably more room — live-tested with nvidia/nemotron-3.5-lightning:free,
# a compound multi-part command needed ~13 steps (lots of repeated
# get_project_outline/search_tasks calls) and one single completion took ~63s.
# If AGENT_STEP_LIMIT errors show up in practice, raise AGENT_MAX_STEPS /
# AGENT_MAX_READ_TOOL_CALLS and OPENROUTER_TIMEOUT_SECONDS together — see
# docs/spikes/mcp-agent-report.md §6 for the live numbers that worked.
AGENT_MAX_STEPS=6
AGENT_MAX_READ_TOOL_CALLS=8
AGENT_HISTORY_TURNS=8
AGENT_MAX_USER_MESSAGE_CHARS=4000

# Mounts the MCP server at /mcp inside this same FastAPI process. AgentService
# is the only MCP client — the frontend never calls /mcp directly.
ENABLE_MCP=true
